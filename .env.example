# Local secrets for the data pipeline. Copy this file to `.env` (which is
# gitignored — never commit your real key) and fill in the values:
#
#   cp .env.example .env
#
# FRED API key — free, instant signup at:
#   https://fred.stlouisfed.org/docs/api/api_key.html
# Used by scripts/fetch_all.py, fetch_credit_latest.py, fetch_debt_maturity.py
# for credit spreads, SOFR/UST series, and debt maturity data.
#
# NOTE: the GitHub Actions pipeline does NOT read this file. For CI, add the
# key as a repository secret instead:
#   GitHub repo → Settings → Secrets and variables → Actions →
#   New repository secret → Name: FRED_API_KEY → paste your key.
FRED_API_KEY=your-key-here
